DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RENDER_EXTERNAL_HOSTNAME=

# Prefer DATABASE_URL in managed hosting. Keep it empty for local SQLite.
DATABASE_URL=
DATABASE_ENGINE=sqlite
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432

AUDIT_HMAC_KEY=change-me-separately-in-production
PILOT_TOKEN_MAX_HOURS=12
CAMILA_PILOT_PASSWORD=
CARMELO_PILOT_PASSWORD=
